# Required for /api/analyze and /api/analyze/batch. Create at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Required for signing analysis results and /api/verify. Use a long random string (e.g. 32+ chars).
SIGNING_SECRET=

# Optional: require API key for all /api/* routes. Set to true to enable.
# When enabled, API_KEYS must be set. Clients send Authorization: Bearer <key> or ?api_key=<key>
REQUIRE_API_KEY=

# Optional: comma-separated list of valid API keys. Only used when REQUIRE_API_KEY is true.
API_KEYS=

# Optional: max requests per minute per IP (or per API key when provided). Default 60.
RATE_LIMIT_REQUESTS_PER_MINUTE=

# Optional: default detector when client omits detector_id. One of: huggingface-image-v1, huggingface-image-v2
# DEFAULT_IMAGE_DETECTOR_ID=

# Optional: persist cache to disk. If set, cache survives restarts (TTL 5 min). Example: .cache/media-auth
# CACHE_DIR=
